  "required_model_modes": ["cpu", "baseline", "lut-exp", "scna-fp16"],
  "required_work": [
    "nonlinear", "attention_correctness", "attention_long_context", "attention_performance",
    "model_ppl", "model_prompt", "model_generation", "model_logits", "cold_start",
    "dedicated_equivalence", "worker_stress", "thermal"
  ],
  "gate_order": [
    "matmul_matrix", "cpu_f16", "standard_f16_htp", "hmx_f16", "hmx_quant_baseline"
  ],
  "on_gate_failure": "AUDIT_INVALID"
}
