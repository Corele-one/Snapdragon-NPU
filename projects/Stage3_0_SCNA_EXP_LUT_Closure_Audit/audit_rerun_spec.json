{
  "schema_version": 1,
  "experiment": "Stage 2.9.1 full audit rerun with repaired model pair",
  "frozen_at": "2026-09-10",
  "inherits": "experiment_spec.json",
  "model_repair_spec": "model_repair_spec.json",
  "result_directory_pattern": "results/formal_<timestamp>_repaired_pair",
  "report_directory_pattern": "reports/final_<timestamp>_repaired_pair",
  "immutable_results": true,
  "case_identity": {
    "fields": ["record_type", "mode", "artifact", "mask", "q", "kv", "head_dim", "seed", "session", "kind", "context", "process"],
