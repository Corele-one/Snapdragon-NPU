+  msg->state.v[0] = 1;
+  if (figure8_wait_channel(msg, 1000000)) {
+    fprintf(stderr, "No-op channel request timed out\n");
+    return -1;
+  }
+  fprintf(stderr, "No-op channel request completed\n");
+  return 0;
+}
